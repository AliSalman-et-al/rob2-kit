.hypothesis/
.ruff_cache/
.mypy_cache/
.pytype/
.tox/
.nox/
build/
dist/
wheels/
*.egg-info
*.whl

# Virtual environments and package-manager caches
.venv/
venv/
ENV/
env/
.uv-cache/
__pypackages__/

# OS and local tooling
.DS_Store
Thumbs.db
*.swp
*.swo
.release-dist/

# Evaluation inputs, runs and traces stay local: trial reports are copyrighted
# and traces quote them. Only the synthetic held-out manifest is tracked.
eval/*
!eval/synthetic-heldout.json

# Local benchmark analysis, calibration, and rendering artifacts
analysis/
prototypes/
tmp/
*.pdf
!tests/fixtures/**/*.pdf
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Assessment workspaces created while trying the tool locally
/input/

# AI Agents
.agents/
.claude/
.claude-config/
.codex/
.rob2-kit/
