# Python-generated files
__pycache__/
*.py[oc]
.coverage
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Evaluation source corpus and provisional labels are local-only; the public
# catalog records trial identifiers and outcome-level denominators.
eval/reference/*
!eval/reference/catalog/
eval/reference/catalog/provisional-labels/
# Keep evaluation runs local except for JSONL results at any nesting depth.
eval/runs/**
!eval/runs/**/
!eval/runs/**/*.jsonl
eval/runs/**/codex-home/
eval/private/

# Local calibration and rendering artifacts
tmp/

# AI Agents
.agents/
.claude/
.claude-config/
.codex/
.rob2-kit/
