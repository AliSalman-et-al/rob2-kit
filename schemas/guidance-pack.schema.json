{
  "$defs": {
    "GuidanceItem": {
      "additionalProperties": false,
      "properties": {
        "affected_change": {
          "enum": [
            "decision_relevant",
            "presentation_only"
          ],
          "title": "Affected Change",
          "type": "string"
        },
        "content_origin": {
          "enum": [
            "official",
            "copied",
            "adapted",
            "maintainer_authored",
            "rob2_kit"
          ],
          "title": "Content Origin",
          "type": "string"
        },
        "counter_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "evidence_targets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Targets",
          "type": "array"
        },
        "inference_boundaries": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inference Boundaries",
          "type": "array"
        },
        "logic_element_id": {
          "title": "Logic Element Id",
          "type": "string"
        },
        "no_information_rule": {
          "default": "",
          "title": "No Information Rule",
          "type": "string"
        },
        "provenance_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance Refs",
          "type": "array"
        },
        "recurring_traps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Recurring Traps",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "logic_element_id",
        "content_origin",
        "text",
        "affected_change"
      ],
      "title": "GuidanceItem",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "A durable citation for material included in a pack release.\n\n``kind`` distinguishes the legal/scientific origin of a citation.  A\nrelease can therefore contain official wording alongside copied or\nadapted material without collapsing the provenance into one free-text\nnote.  Existing pack sources may omit ``id`` and ``kind`` while migrating\nto the richer release format; loaded objects still receive deterministic\ndefaults.",
      "properties": {
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "official",
          "enum": [
            "official",
            "copied",
            "adapted",
            "maintainer_authored"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "title",
        "version",
        "url",
        "license"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Authors",
      "type": "array"
    },
    "compatible_logic_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Compatible Logic Hashes",
      "type": "array"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "counter_evidence": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Counter Evidence",
      "type": "array"
    },
    "evidence_targets": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Targets",
      "type": "array"
    },
    "family_id": {
      "title": "Family Id",
      "type": "string"
    },
    "inference_boundaries": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Inference Boundaries",
      "type": "array"
    },
    "inventory": {
      "items": {
        "type": "string"
      },
      "title": "Inventory",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/GuidanceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "no_information_rule": {
      "default": "",
      "title": "No Information Rule",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "recurring_traps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Recurring Traps",
      "type": "array"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "required_schema_version": {
      "const": "1.0.0",
      "title": "Required Schema Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "required_schema_version",
    "family_id",
    "release_id",
    "authors",
    "language",
    "compatible_logic_hashes",
    "items",
    "inventory",
    "provenance"
  ],
  "title": "GuidancePack",
  "type": "object"
}
