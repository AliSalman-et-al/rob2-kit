{
  "$defs": {
    "AssessorInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^input:[a-z0-9:-]+$",
          "title": "Id",
          "type": "string"
        },
        "required_if": {
          "$ref": "#/$defs/Condition"
        },
        "value_type": {
          "const": "boolean",
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value_type",
        "required_if"
      ],
      "title": "AssessorInput",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SQAnswerCategory"
          },
          "title": "Answers",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "input_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Id"
        },
        "judgment": {
          "anyOf": [
            {
              "$ref": "#/$defs/JudgmentLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "judgments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/JudgmentLevel"
          },
          "title": "Judgments",
          "type": "array"
        },
        "minimum": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "op": {
          "enum": [
            "all",
            "any",
            "answer_in",
            "domain_all",
            "domain_any",
            "domain_count",
            "input_equals"
          ],
          "title": "Op",
          "type": "string"
        },
        "question_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Id"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "op"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Domain": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^domain:[a-z0-9:-]+$",
          "title": "Id",
          "type": "string"
        },
        "judgment_rules": {
          "items": {
            "$ref": "#/$defs/JudgmentRule"
          },
          "title": "Judgment Rules",
          "type": "array"
        },
        "question_ids": {
          "items": {
            "type": "string"
          },
          "title": "Question Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "question_ids",
        "judgment_rules"
      ],
      "title": "Domain",
      "type": "object"
    },
    "JudgmentLevel": {
      "enum": [
        "low",
        "some_concerns",
        "high"
      ],
      "title": "JudgmentLevel",
      "type": "string"
    },
    "JudgmentRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^rule:[a-z0-9:-]+$",
          "title": "Id",
          "type": "string"
        },
        "judgment": {
          "$ref": "#/$defs/JudgmentLevel"
        },
        "when": {
          "$ref": "#/$defs/Condition"
        }
      },
      "required": [
        "id",
        "when",
        "judgment"
      ],
      "title": "JudgmentRule",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "A durable citation for material included in a pack release.\n\n``kind`` distinguishes the legal/scientific origin of a citation.  A\nrelease can therefore contain official wording alongside copied or\nadapted material without collapsing the provenance into one free-text\nnote.  Existing pack sources may omit ``id`` and ``kind`` while migrating\nto the richer release format; loaded objects still receive deterministic\ndefaults.",
      "properties": {
        "attribution": {
          "default": "",
          "title": "Attribution",
          "type": "string"
        },
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "official",
          "enum": [
            "official",
            "copied",
            "adapted",
            "maintainer_authored"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "title",
        "version",
        "url",
        "license"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "active_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "allowed_answers": {
          "default": [
            "yes",
            "probably_yes",
            "probably_no",
            "no",
            "no_information"
          ],
          "items": {
            "$ref": "#/$defs/SQAnswerCategory"
          },
          "title": "Allowed Answers",
          "type": "array"
        },
        "id": {
          "pattern": "^sq:[a-z0-9:-]+$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Question",
      "type": "object"
    },
    "SQAnswerCategory": {
      "enum": [
        "yes",
        "probably_yes",
        "probably_no",
        "no",
        "no_information"
      ],
      "title": "SQAnswerCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_answers": {
      "items": {
        "$ref": "#/$defs/SQAnswerCategory"
      },
      "title": "Allowed Answers",
      "type": "array"
    },
    "assessor_inputs": {
      "items": {
        "$ref": "#/$defs/AssessorInput"
      },
      "title": "Assessor Inputs",
      "type": "array"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Authors",
      "type": "array"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/Domain"
      },
      "title": "Domains",
      "type": "array"
    },
    "effect_of_interest": {
      "const": "assignment",
      "title": "Effect Of Interest",
      "type": "string"
    },
    "family_id": {
      "title": "Family Id",
      "type": "string"
    },
    "instrument": {
      "const": "rob2",
      "title": "Instrument",
      "type": "string"
    },
    "inventory": {
      "items": {
        "type": "string"
      },
      "title": "Inventory",
      "type": "array"
    },
    "overall_rules": {
      "items": {
        "$ref": "#/$defs/JudgmentRule"
      },
      "title": "Overall Rules",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "required_schema_version": {
      "const": "1.0.0",
      "title": "Required Schema Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trial_design": {
      "const": "individually_randomized_parallel_group",
      "title": "Trial Design",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "required_schema_version",
    "family_id",
    "release_id",
    "authors",
    "instrument",
    "trial_design",
    "effect_of_interest",
    "allowed_answers",
    "questions",
    "domains",
    "assessor_inputs",
    "overall_rules",
    "inventory",
    "provenance"
  ],
  "title": "LogicPack",
  "type": "object"
}
