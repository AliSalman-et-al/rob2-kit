  "license": "MIT",
  "keywords": ["risk-of-bias", "rob2", "cochrane", "systematic-review", "randomized-trials", "evidence-synthesis"],
  "skills": "./src/rob2_kit/skills/",
  "mcpServers": {
    "rob2": {
      "command": "uvx",
      "args": ["--from", "${CLAUDE_PLUGIN_ROOT}", "rob2", "mcp"]
    }
  }
