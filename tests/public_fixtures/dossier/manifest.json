{
  "schema_version": 1,
  "dossier_id": "dossier:synthetic-trial",
  "trial_id": "trial:aurora",
  "trial_name": "AURORA synthetic individually randomised trial",
  "sources": [
    {
      "source_id": "source:aurora-report",
      "role": "full_text",
      "path": "sources/full-text.txt",
      "description": "Result-bearing primary report with conduct and outcome text"
    },
    {
      "source_id": "source:aurora-protocol",
      "role": "protocol",
      "path": "sources/protocol.txt",
      "description": "Prespecified protocol and estimand"
    },
    {
      "source_id": "source:aurora-sap",
      "role": "sap",
      "path": "sources/sap.txt",
      "description": "Statistical analysis plan and time-point policy"
    },
    {
      "source_id": "source:aurora-supplement",
      "role": "supplement",
      "path": "sources/supplement.txt",
      "description": "Supplementary CONSORT and missing-data tables"
    },
    {
      "source_id": "source:aurora-registry",
      "role": "registry",
      "path": "sources/registry.json",
      "description": "Synthetic registry projection with registration and outcome fields"
    },
    {
      "source_id": "source:aurora-evidence",
      "role": "evidence",
      "path": "sources/evidence.json",
      "description": "Attributable evidence snippets covering all five RoB 2 Domains"
    }
  ],
  "domains": {
    "randomization": ["evidence:randomization-sequence", "evidence:allocation-concealment"],
    "deviations": ["evidence:deviations-awareness", "evidence:deviations-analysis"],
    "missing": ["evidence:missing-data"],
    "measurement": ["evidence:measurement-blinding", "evidence:measurement-method"],
    "selection": ["evidence:selection-prespecification", "evidence:selection-timepoint"]
  },
  "overlays": [
    {"overlay_id": "optional-source-absence", "path": "overlays/optional-source-absence.json", "description": "Remove the optional supplement while retaining a usable report", "changes": ["remove:source:aurora-supplement"]},
    {"overlay_id": "chronology-conflict", "path": "overlays/chronology-conflict.json", "description": "Introduce a dated protocol/report discrepancy", "changes": ["report:2024-06-01", "protocol:2024-02-01"]},
    {"overlay_id": "multiple-time-points", "path": "overlays/multiple-time-points.json", "description": "Expose 30-day and 12-month outcome estimates", "changes": ["add:time-point:12-months"]},
    {"overlay_id": "duplicates", "path": "overlays/duplicates.json", "description": "Add byte-identical report and a superseding analysis", "changes": ["duplicate:source:aurora-report", "supersede:analysis-2"]},
    {"overlay_id": "another-trial-discussion", "path": "overlays/another-trial-discussion.json", "description": "Put another Trial's Discussion keyword beside AURORA text", "changes": ["other-trial:nebula"]},
    {"overlay_id": "bibliography-trap", "path": "overlays/bibliography-trap.json", "description": "Put target terms in references without conduct evidence", "changes": ["bibliography-only:randomisation"]},
    {"overlay_id": "layout-dependent-table", "path": "overlays/layout-dependent-table.json", "description": "Represent a table whose meaning depends on column headers", "changes": ["table:headers-required"]},
    {"overlay_id": "prompt-injection", "path": "overlays/prompt-injection.json", "description": "Include inert source-authored instructions that must not steer the Harness", "changes": ["source-text:ignore-agent-instructions"]},
    {"overlay_id": "unreadable-content", "path": "overlays/unreadable-content.json", "description": "Mark a corrupt or image-only optional page", "changes": ["parse:unreadable-page-7"]},
    {"overlay_id": "changed-input", "path": "overlays/changed-input.json", "description": "Change a report byte and require scoped invalidation", "changes": ["content-change:source:aurora-report"]}
  ],
  "prompt_families": [
    {"family_id": "direct", "prompts": ["Assess AURORA for mortality at 30 days."]},
    {"family_id": "indirect", "prompts": ["How much risk of bias is there for the Aurora death outcome?"]},
    {"family_id": "synonym", "prompts": ["Review AURORA side effects and mortality at the first follow-up."]},
    {"family_id": "multi-result", "prompts": ["Assess AURORA mortality at 30 days and quality of life at 12 months."]},
    {"family_id": "resume", "prompts": ["Continue the current AURORA assessment."]},
    {"family_id": "start-new", "prompts": ["Start a new AURORA assessment for quality of life."]},
    {"family_id": "correction", "prompts": ["Correction: use the 12-month analysis population for AURORA."]},
    {"family_id": "status", "prompts": ["What is the current status of the AURORA run?"]},
    {"family_id": "explanation", "prompts": ["Explain why the AURORA measurement Domain has this judgment."]},
    {"family_id": "negative", "negative": true, "prompts": ["Search the web for an unrelated cohort.", "Edit the published report directly.", "Assess this non-randomised case study."]}
  ]
}
