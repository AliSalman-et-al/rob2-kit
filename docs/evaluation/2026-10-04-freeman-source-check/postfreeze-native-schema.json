{
  "$defs": {
    "SourceCheckFinding": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "justification",
            "unknowns",
            "counterevidence",
            "citations",
            "missing_data"
          ],
          "title": "Field",
          "type": "string"
        },
        "clause": {
          "minLength": 1,
          "title": "Clause",
          "type": "string"
        },
        "classification": {
          "enum": [
            "supported_fact",
            "legitimate_inference",
            "narrower_support",
            "citation_gap",
            "contradicted_fact",
            "unresolved"
          ],
          "title": "Classification",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "uncertainty": {
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/SourceCheckReference"
          },
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "field",
        "clause",
        "classification",
        "explanation",
        "uncertainty",
        "references"
      ],
      "title": "SourceCheckFinding",
      "type": "object"
    },
    "SourceCheckReference": {
      "additionalProperties": false,
      "description": "A locatable source observation, not a semantic certificate.",
      "properties": {
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkingSourceRange"
            },
            {
              "$ref": "#/$defs/VisualEvidenceReference"
            }
          ],
          "title": "Location"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quote"
        },
        "relation": {
          "enum": [
            "supports",
            "corrects",
            "limits"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "location",
        "quote",
        "relation"
      ],
      "title": "SourceCheckReference",
      "type": "object"
    },
    "VisualEvidenceReference": {
      "additionalProperties": false,
      "description": "Host transcription of an authentic delivered image, not verified OCR.",
      "properties": {
        "delivery_receipt": {
          "description": "Receipt returned alongside render_page ImageContent for this Trial.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Delivery Receipt",
          "type": "string"
        },
        "region": {
          "description": "Normalized x0,y0,x1,y1 bounds of the transcribed image region.",
          "maxItems": 4,
          "minItems": 4,
          "title": "Region",
          "type": "array",
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          }
        },
        "transcription": {
          "description": "Literal self-contained account of the region, including relevant labels, values, units, denominators and footnotes. This is a host observation, not OCR truth.",
          "minLength": 1,
          "title": "Transcription",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional uncertainty about the image interpretation; do not invent a value.",
          "title": "Uncertainty"
        }
      },
      "required": [
        "delivery_receipt",
        "region",
        "transcription",
        "uncertainty"
      ],
      "title": "VisualEvidenceReference",
      "type": "object"
    },
    "WorkingSourceRange": {
      "additionalProperties": false,
      "description": "One exact, recoverable source location kept in a derivative checkpoint.",
      "properties": {
        "source_id": {
          "description": "Source handle from the current Trial.",
          "pattern": "^sh_[0-9a-f]{16}$",
          "title": "Source Id",
          "type": "string"
        },
        "page": {
          "description": "1-based page index in the captured Source.",
          "ge": 1,
          "title": "Page",
          "type": "integer"
        },
        "start_line": {
          "description": "First cited line; use 0 only with end_line 0 for a whole-page visual locator.",
          "minimum": 0,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "description": "Last cited line; use 0 only with start_line 0 for a whole-page visual locator.",
          "minimum": 0,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "source_id",
        "page",
        "start_line",
        "end_line"
      ],
      "title": "WorkingSourceRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshot_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Identity",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/SourceCheckFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "snapshot_identity",
    "findings"
  ],
  "title": "SourceCheckReport",
  "type": "object"
}
