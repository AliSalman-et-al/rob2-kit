      "approvalPolicy",
      "approvalsReviewer",
      "baseInstructions",
      "config",
      "cwd",
      "developerInstructions",
      "ephemeral",
      "excludeTurns",
      "lastTurnId",
      "model",
      "modelProvider",
      "sandbox",
      "serviceTier",
      "threadId",
      "threadSource"
    ],
    "required": [
      "threadId"
    ],
    "lastTurnId": {
      "description": "Optional last turn id to fork through, inclusive.\n\nWhen specified, turns after `last_turn_id` are omitted from the fork. The referenced turn cannot be in progress.",
      "type": [
        "string",
        "null"
      ]
    }
  },
