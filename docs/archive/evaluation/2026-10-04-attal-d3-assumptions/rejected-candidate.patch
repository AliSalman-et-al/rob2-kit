diff --git a/tests/test_comparison_cards.py b/tests/test_comparison_cards.py
index 1a06138..207919f 100644
--- a/tests/test_comparison_cards.py
+++ b/tests/test_comparison_cards.py
@@ -537,3 +537,34 @@ def test_analysis_rule_context_preserves_conditional_inference() -> None:
     assert all(
         not {"expected_answer", "expected_judgment", "severity"} & p.keys() for p in pairs.values()
     )
+
+
+def test_missingness_robustness_has_its_own_unclassified_comparison(tmp_path: Path) -> None:
+    workspace, evidence, revision = _assessment_workspace(tmp_path)
+    revision = _save_domain(workspace, "domain:randomization", revision, evidence)
+    _save_domain(workspace, "domain:deviations", revision, evidence)
+    context = _call(workspace, "get_domain_context", {"domain_id": "domain:missing"})["data"]
+    cards = context["comparison_cards"]
+    availability = next(
+        card for card in cards if card["question_id"] == "sq:missing:data-available"
+    )
+    robustness = next(
+        card for card in cards if card["question_id"] == "sq:missing:evidence-unbiased"
+    )
+    assert robustness["card_id"] != availability["card_id"]
+    assert robustness["result_identity"] == availability["result_identity"]
+    assert robustness["reported_result"] == availability["reported_result"]
+    assert robustness["passage_groups"] == availability["passage_groups"]
+    assert {slot["name"] for slot in robustness["slots"]} == {
+        "primary_missingness_assumptions",
+        "sensitivity_changed_assumptions",
+        "sensitivity_retained_assumptions",
+        "estimate_comparison_for_approved_result",
+        "missingness_mechanism_correspondence",
+    }
+    assert all(slot["status"] == "unknown" and not slot["passages"] for slot in robustness["slots"])
+    assert all(
+        item["question_id"] == robustness["question_id"] for item in robustness["propositions"]
+    )
+    assert not robustness["participant_flow"]
+    assert "conditional MAR can be credible" in robustness["prompt"]
