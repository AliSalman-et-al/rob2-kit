  "answers": [
    {
      "question_id": "sq:selection:prespecified-analysis",
      "answer": "no_information",
      "justification": "A protocol/SAP is available and specifies a 24-month endpoint analysis in ITT and per-protocol populations. However, participants and investigators were unmasked, and the captured protocol/SAP has no date or amendment history establishing that the final analysis plan preceded unblinded outcome access. Registry submission and study-start dates do not date this SAP version.",
      "unknowns": [
        "When the SAP was finalized and whether any amendments were made before unblinded outcome data were available."
      ],
      "counterevidence": []
    },
    {
      "question_id": "sq:selection:multiple-measurements",
      "answer": "no",
      "justification": "The protocol identifies one primary endpoint: the specified composite at 24 months after randomization. Although follow-up visits were planned at 12 and 24 months, the primary outcome was fixed at 24 months, and the reported primary result uses that endpoint and window. No competing eligible measurement for this primary composite is identified.",
      "unknowns": [],
      "counterevidence": []
    },
    {
      "question_id": "sq:selection:multiple-analyses",
      "answer": "no_information",
      "justification": "The primary ITT analysis and supportive per-protocol result are both reported, with similar effects, and the article reports both a Cox hazard ratio and log-rank result. This does not show result-based selection. However, the protocol also planned an imputation sensitivity analysis that is not located in the report, and the reported Cox estimate is not specified in the captured SAP. The available intentions and reporting therefore do not fully resolve the eligible analysis set.",
      "unknowns": [
        "Whether the planned multiple-imputation analysis was conducted or why its result was not reported.",
        "Whether the Cox model was prespecified in a later or amended analysis plan."
      ],
      "counterevidence": []
    }
  ],
